---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found"
  description="That path is not on cloud-dispatch. Head home or browse the notes."
  path="/404/"
  noindex
>
  <section class="error-page" aria-labelledby="error-heading">
    <p class="error-code" aria-hidden="true">404</p>
    <h1 id="error-heading">Nothing dispatched here</h1>
    <p class="error-lead">
      That URL is not a page on this site. It may have moved, or the link was wrong.
    </p>
    <div class="cta-row">
      <a class="btn btn-primary" href={base}>Home</a>
      <a class="btn" href={`${base}notes/`}>Browse notes</a>
    </div>
  </section>
</BaseLayout>
