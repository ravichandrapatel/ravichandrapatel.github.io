---
import BaseLayout from "../layouts/BaseLayout.astro";
import ObsidianGraphBg from "../components/ObsidianGraphBg.tsx";
import { PLATFORM_TOOLS } from "../lib/toolIcons";

const base = import.meta.env.BASE_URL;

/** Tool constellation only — posts stay on /posts, not as duplicate graph hubs. */
const seeds = PLATFORM_TOOLS.map((tool) => ({
  id: tool.id,
  label: tool.label,
  icon: tool.icon,
  hub: false,
  links: tool.links,
}));
---

<BaseLayout title="cloud-dispatch" path="/">
  <section class="hero">
    <ObsidianGraphBg client:load seeds={seeds} />
    <div class="hero-inner">
      <h1 class="hero-brand">cloud-<em>dispatch</em></h1>
      <p class="hero-lead">
        Field notes on AWS, Azure, GCP, Linux, and DevOps — written by Ravichandra.
        Practical dispatches from multi-cloud operations.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}posts/`}>Browse notes</a>
        <a class="btn" href={`${base}about/`}>About the author</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Coverage</h2>
    <p>
      Expect concise write-ups on cloud architecture, identity and networking, Linux
      operations, CI/CD, and GitOps patterns — without vendor lock-in theater.
    </p>
    <div class="tag-row" aria-label="Topics">
      <span class="tag">aws</span>
      <span class="tag">azure</span>
      <span class="tag">gcp</span>
      <span class="tag">linux</span>
      <span class="tag">devops</span>
    </div>
  </section>
</BaseLayout>
