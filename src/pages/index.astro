---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="cloud-dispatch" path="/">
  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-brand">cloud-<em>dispatch</em></h1>
      <p class="hero-lead">
        Field notes on AWS, Azure, GCP, Linux, and DevOps — written by Ravichandra Patel.
        Practical dispatches from multi-cloud operations.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${base}posts/`}>Browse notes</a>
        <a class="btn" href={`${base}about/`}>About the author</a>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>Coverage</h2>
    <p>
      Expect concise write-ups on cloud architecture, identity and networking, Linux
      operations, CI/CD, and GitOps patterns — without vendor lock-in theater.
    </p>
    <div class="tag-row" aria-label="Topics">
      <span class="tag">aws</span>
      <span class="tag">azure</span>
      <span class="tag">gcp</span>
      <span class="tag">linux</span>
      <span class="tag">devops</span>
    </div>
  </section>
</BaseLayout>
