---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Notes"
  description="Field notes on cloud-dispatch."
  path="/posts/"
>
  <article class="prose">
    <h1>Notes</h1>
    <p class="meta">Field notes · newest first</p>

    {
      posts.length === 0 ? (
        <div class="empty-state">
          No notes yet. Add Markdown/MDX under <code>src/content/posts/</code> with
          title, description, pubDate, and optional tags.
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
              <p class="desc">{post.data.description}</p>
              <p class="meta">
                {post.data.pubDate.toISOString().slice(0, 10)}
                {post.data.tags.length > 0 ? ` · ${post.data.tags.join(", ")}` : ""}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>
