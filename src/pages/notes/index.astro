---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";

const base = import.meta.env.BASE_URL;
const posts = await getPublishedPosts();
---

<BaseLayout
  title="Notes"
  description="Field notes on cloud-dispatch."
  path="/notes/"
>
  <article class="prose">
    <h1>Notes</h1>
    <p class="meta">Field notes · newest first</p>

    {
      posts.length === 0 ? (
        <div class="empty-state">
          No notes yet. Add Markdown/MDX under <code>src/content/posts/</code> with
          title, description, pubDate, and optional tags.
        </div>
      ) : (
        <ul class="post-list">
          {posts.map((post) => {
            const coverSrc = post.data.cover
              ? `${base}${post.data.cover.replace(/^\//, "")}`
              : undefined;
            return (
              <li class={coverSrc ? "has-cover" : undefined}>
                {coverSrc && (
                  <a class="post-list-cover" href={`${base}notes/${post.id}/`} tabindex="-1" aria-hidden="true">
                    <img src={coverSrc} alt="" width="1600" height="900" loading="lazy" />
                  </a>
                )}
                <div class="post-list-body">
                  <a href={`${base}notes/${post.id}/`}>{post.data.title}</a>
                  <p class="desc">{post.data.description}</p>
                  <p class="meta">
                    {post.data.pubDate.toISOString().slice(0, 10)}
                    {post.data.tags.length > 0 ? ` · ${post.data.tags.join(", ")}` : ""}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </article>
</BaseLayout>
