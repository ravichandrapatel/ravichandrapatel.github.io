---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  path?: string;
  cover?: string;
  /** When true, ask crawlers not to index (e.g. 404). */
  noindex?: boolean;
}

const SITE_AUTHOR = "Ravichandra";

const {
  title,
  description = "AWS · Azure · GCP · Linux · DevOps — field notes by Ravichandra.",
  path = "/",
  cover,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const canonical = new URL(path.replace(/^\//, ""), Astro.site);
const pageTitle = title === "cloud-dispatch" ? title : `${title} · cloud-dispatch`;
const coverHref = cover
  ? new URL(cover.replace(/^\//, ""), Astro.site).href
  : new URL("logo.png", Astro.site).href;
const logoHref = new URL("logo.png", Astro.site).href;
const isPost = path.startsWith("/notes/") && path !== "/notes/";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": isPost ? "BlogPosting" : "WebPage",
  headline: title,
  description,
  url: canonical.href,
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: "https://github.com/ravichandrapatel",
  },
  publisher: {
    "@type": "Organization",
    name: "cloud-dispatch",
    url: "https://ravichandrapatel.github.io/",
    logo: {
      "@type": "ImageObject",
      url: logoHref,
    },
  },
  image: coverHref,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="cloud-dispatch" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content={isPost ? "article" : "website"} />
    <meta property="og:image" content={coverHref} />
    <meta property="article:author" content={SITE_AUTHOR} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={coverHref} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      (function () {
        try {
          var key = "cd-theme";
          var stored = localStorage.getItem(key);
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (_) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="header-cluster">
          <a class="brand" href={base}>
            <img
              class="brand-mark"
              src={`${base}favicon.svg`}
              width="26"
              height="26"
              alt=""
              decoding="async"
            />
            <span class="brand-text">cloud-<em>dispatch</em></span>
          </a>
          <nav class="nav" aria-label="Primary">
            <a href={base} aria-current={path === "/" ? "page" : undefined}>Home</a>
            <a href={`${base}notes/`} aria-current={path.startsWith("/notes") ? "page" : undefined}
              >Notes</a
            >
            <a
              href={`${base}spvs-checker/`}
              aria-current={path.startsWith("/spvs-checker") ? "page" : undefined}
              >OWASP SPVS Validator</a
            >
            <a href={`${base}about/`} aria-current={path === "/about/" ? "page" : undefined}
              >About</a
            >
          </nav>
        </div>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label="Toggle light and dark theme"
          title="Toggle theme"
        >
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5z"></path>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {SITE_AUTHOR}</p>
      </footer>
    </div>
    <script is:inline>
      (function () {
        var key = "cd-theme";
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;

        function current() {
          return document.documentElement.getAttribute("data-theme") === "light"
            ? "light"
            : "dark";
        }

        function apply(theme) {
          document.documentElement.setAttribute("data-theme", theme);
          try {
            localStorage.setItem(key, theme);
          } catch (_) {}
          document.dispatchEvent(
            new CustomEvent("cd-themechange", { detail: { theme: theme } }),
          );
        }

        btn.addEventListener("click", function () {
          apply(current() === "light" ? "dark" : "light");
        });
      })();
    </script>
  </body>
</html>
